{
  "create": {
    "method": "POST", "path": "/simulations",
    "body": { "name": "Studio replay", "mode": "HISTORICAL_REPLAY", "start_date": "{start_date}", "end_date": "{end_date}", "starting_capital_rs": 10000000, "operating_mode": "AUTONOMOUS_PAPER", "policy_id": "{policy_id}", "max_proposals_per_session": 5, "seed": 42, "speed": "STEP" },
    "expect": [201]
  },
  "create_accelerated": {
    "method": "POST", "path": "/simulations",
    "body": { "name": "Studio accelerated", "mode": "ACCELERATED_REPLAY", "start_date": "{start_date}", "end_date": "{start_date}", "starting_capital_rs": 5000000, "operating_mode": "ASSISTED", "policy_id": "{policy_id}", "max_proposals_per_session": 3, "symbols": ["PETRONET", "GRASIM"], "seed": 8841, "speed": "ACCELERATED" },
    "expect": [201]
  },
  "create_default_policy": {
    "method": "POST", "path": "/simulations",
    "body": { "name": "Studio replay", "mode": "HISTORICAL_REPLAY", "start_date": "{start_date}", "end_date": "{end_date}", "starting_capital_rs": 10000000, "operating_mode": "AUTONOMOUS_PAPER", "max_proposals_per_session": 5, "seed": 42, "speed": "STEP" },
    "expect": [201]
  },
  "start": { "method": "POST", "path": "/simulations/{simulation_id}/start", "body": null, "expect": [200] },
  "run": { "method": "POST", "path": "/simulations/{simulation_id}/run", "body": null, "expect": [202] }
}
