{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "app/**",
              "ui_kits/copilot/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Serif|Inter Tight|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Instrument Serif, Inter Tight, JetBrains Mono."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--amber",
      "--amber-2",
      "--amber-line",
      "--amber-soft",
      "--bg-0",
      "--bg-1",
      "--bg-2",
      "--bg-3",
      "--bg-4",
      "--bg-glass",
      "--bg-spot-a",
      "--bg-spot-b",
      "--danger",
      "--danger-2",
      "--danger-line",
      "--danger-soft",
      "--display",
      "--indigo",
      "--indigo-2",
      "--indigo-line",
      "--indigo-soft",
      "--ink",
      "--ink-2",
      "--ink-3",
      "--ink-4",
      "--ink-5",
      "--line",
      "--line-2",
      "--line-3",
      "--mint",
      "--mint-2",
      "--mint-line",
      "--mint-soft",
      "--mono",
      "--radius-lg",
      "--radius-md",
      "--radius-sm",
      "--radius-xl",
      "--radius-xs",
      "--rose",
      "--sans",
      "--shadow-card",
      "--shadow-pop"
    ],
    "tokenKinds": {
      "--bg-0": "color",
      "--bg-1": "color",
      "--bg-2": "color",
      "--bg-3": "color",
      "--bg-4": "color",
      "--bg-glass": "color",
      "--bg-spot-a": "color",
      "--bg-spot-b": "color",
