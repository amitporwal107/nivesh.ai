# /etc/cron.d/nidp-staging-db-snapshot — weekly encrypted TimescaleDB snapshot
# of the warehouse VM (nidp-staging-vm, 45.64.105.224) → private GitHub release.
#
# Sunday 03:30 IST. Deliberately NOT 02:30: /etc/cron.d/nidp-staging already
# runs a job at 02:30 daily, and the app VM's snapshot takes that slot. The
# warehouse's own feed jobs resume at 06:00, leaving 03:30-06:00 free for a
# 16 GB dump.
#
# Retention is LATEST ONLY — each run replaces the previous release assets.
#
# Install:
#   sudo bash install.sh --target nidp --repo <owner/repo> \
#       --token-file <f> --pubkey-file <k>

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Asia/Kolkata
MAILTO=""

30 3 * * 0  root  /opt/nidp-staging/bin/db-snapshot.sh --target nidp >> /opt/nidp-staging/logs/db-snapshot.log 2>&1
