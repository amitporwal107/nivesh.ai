# Template for the Cloudflare DNS migration config.
# Copy OUTSIDE the repo, fill in, and lock it down:
#   mkdir -p ~/.config/nivesh
#   cp deploy/cloudpe/cloudflare.env.example ~/.config/nivesh/cloudflare.env
#   chmod 600 ~/.config/nivesh/cloudflare.env
# Never commit the filled-in file.

# API token scoped to this zone only: Zone → DNS → Edit and Zone → Zone → Read.
CF_API_TOKEN=

CF_ZONE_NAME=niveshcopilot.com

# OLD_IP=NEW_IP pairs. GCP app VM -> cloudpe1, GCP NIDP VM -> cloudpe2.
IP_MAP=34.47.250.214=45.64.105.88,34.93.60.254=45.64.105.224

# Records to leave alone (comma-separated full names).
SKIP_NAMES=ide.niveshcopilot.com
