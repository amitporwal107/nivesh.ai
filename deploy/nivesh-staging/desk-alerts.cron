# /etc/cron.d/nivesh-staging-desk-alerts — evening check of every user's
# Smart trading desk paper trades and price alerts [staging].
#
# Applies the end-of-day exit rules to open paper trades (cash: stop/target/
# time; F&O strategy trades: stop/target/expiry/time at the session's marks)
# and the firing rule to active alerts (backend/scripts/check_desk_alerts.py,
# same rules as GET /api/desk/paper-trades and /api/desk/alerts). In-app only:
# results show in the desk's lists; no email or push. No orders, no brokers.
#
# Schedule (Asia/Kolkata): 20:45 IST Mon-Fri, retry 22:45. The NIDP bhavcopy
# ingest runs at 19:00 IST and the F&O bhavcopy at 19:30 with retries at 21:00
# and 22:15 (deploy/cloudpe/nidp/nidp-staging.cron), so the day's raw close is
# in nidp.prices_eod by 20:45; runs after the 20:00 positional-engine and 20:15
# ai-watchlist slots to avoid contending for the same container.
# KEEP IN STEP with services/job_runs.SCHEDULES["check_desk_alerts"] (the
# missed-run check); tests/test_desk_exit_job.py compares the two.
#
# Guards (exit codes in the script's docstring):
#   flock -n -E 4      a run still going from an earlier slot (or a manual run
#                      started with the same lock) makes this one exit 4
#   --require-bars     no session today (holiday/weekend) -> exit 3; the
#                      session's bars not in the data platform yet -> exit 2;
#                      nothing is evaluated or written in either case
#   --skip-if-done     the 22:45 retry does nothing when 20:45 recorded "ok"
# Every run that writes records a heartbeat in Mongo job_runs; read it with
#   GET /api/admin/risk/jobs/check_desk_alerts   (admin; "missed" when no run
#   was recorded since the latest slot + 60 min)
# A failed or partial run is caught up by the next one: each run checks from
# the trade's or alert's first session onward, and every close is written with
# status "open" in its filter, so nothing closes twice.
#
# Install (one-off, not CI-managed — see deploy/nivesh-staging/install-desk-alerts.sh):
#   sudo bash /opt/nivesh-staging/repo/deploy/nivesh-staging/install-desk-alerts.sh

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Asia/Kolkata
MAILTO=""

45 20 * * 1-5  root  /usr/bin/flock -n -E 4 /run/lock/nivesh-staging-desk-alerts.lock /usr/bin/docker exec nivesh-staging-app-backend python -m scripts.check_desk_alerts --require-bars --skip-if-done >> /opt/nivesh-staging/logs/desk-alerts.log 2>&1; rc=$?; [ "$rc" -ne 0 ] && echo "$(date -Is) [desk-alerts] exit $rc" >> /opt/nivesh-staging/logs/desk-alerts.log
45 22 * * 1-5  root  /usr/bin/flock -n -E 4 /run/lock/nivesh-staging-desk-alerts.lock /usr/bin/docker exec nivesh-staging-app-backend python -m scripts.check_desk_alerts --require-bars --skip-if-done >> /opt/nivesh-staging/logs/desk-alerts.log 2>&1; rc=$?; [ "$rc" -ne 0 ] && echo "$(date -Is) [desk-alerts] exit $rc" >> /opt/nivesh-staging/logs/desk-alerts.log
