# Container image for the portfolio_ingestion service running on staging.
#
# Slim Python image. Installs only the runtime dependencies the new package
# needs; reuses pieces from backend/ via PYTHONPATH=/app/backend so the
# package can `import core.logging_config` read-only without copying files.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/backend

WORKDIR /app

# Minimal system deps; no PDF / OCR libs needed in staging V1 (SDK does parsing)
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Copy the new package and the read-only sibling modules it imports
COPY backend/portfolio_ingestion /app/backend/portfolio_ingestion
COPY backend/core                /app/backend/core

# Install runtime deps directly (the new package has no requirements.txt yet;
# we keep the dependency surface small and explicit).
RUN pip install \
        "fastapi==0.110.1" \
        "uvicorn[standard]==0.25.0" \
        "pydantic==2.12.5" \
        "asyncpg==0.31.0" \
        "motor==3.3.1" \
        "httpx==0.28.1" \
        "pytest==9.0.3" \
        "pytest-asyncio==0.24.0"

EXPOSE 8002

# Run uvicorn directly; logs go to stdout in JSON via core.logging_config
# (which configure_logging() re-applies at app startup, overriding uvicorn's
# default formatters).
CMD ["uvicorn", "portfolio_ingestion.main:app", \
     "--host", "0.0.0.0", "--port", "8002", \
     "--app-dir", "/app/backend", \
     "--no-access-log"]
