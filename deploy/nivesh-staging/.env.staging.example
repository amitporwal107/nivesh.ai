# Template for /opt/nivesh-staging/.env.staging on nivesh-app-vm.
# Generated automatically by bootstrap-staging.sh with random secrets;
# this file is committed only as documentation. Never put real secrets here.

# Postgres
PI_POSTGRES_USER=pi_staging
PI_POSTGRES_PASSWORD=CHANGEME_random
PI_POSTGRES_DB=portfolio_ingestion

# Mongo
PI_MONGO_USER=pi_staging
PI_MONGO_PASSWORD=CHANGEME_random
PI_MONGO_DB=portfolio_ingestion

# Redis
PI_REDIS_PASSWORD=CHANGEME_random

# PAN encryption (T2.3). Rotating this orphans previously-encrypted PANs.
PI_PAN_ENCRYPTION_KEY=CHANGEME_random_hex

# CASParser (T1.6 / T3.2). Leave PI_CASPARSER_API_KEY unset to use stub mode.
# PI_CASPARSER_API_KEY=
# PI_CASPARSER_BASE_URL=https://api.casparser.in

# GCS upload (T3.1). Stub by default; set bucket + ADC for production.
# PI_GCS_BUCKET=nivesh-staging-cas
# PI_GCS_SA_KEY_PATH=/secrets/gcs-sa.json
PI_GCS_STUB=true

# Inbound-email webhook (T3.3). Disabled by default.
PI_WEBHOOK_ENABLED=false
# PI_WEBHOOK_SECRET=CHANGEME_random

# Operator endpoints (T4.3). Required by /api/admin/jobs/*.
PI_ADMIN_TOKEN=CHANGEME_random

# Nginx bind — 127.0.0.1 until firewall is opened, then 0.0.0.0
PI_NGINX_BIND_ADDR=127.0.0.1
PI_NGINX_PORT=8443
