# /etc/cron.d/nivesh-staging-ai-watchlist — store the day's AI scanner watchlist (Top 10 cash + Top 10 F&O ideas) [staging].
#
# Runs after the AI scanner (nivesh-staging-positional-engine: 19:45 IST, retry 21:45), Mon-Fri (the VM's clock is IST):
#   20:15 IST  build and store the day's lists (services/ai_watchlist_build, as the system caller).
#   22:15 IST  retry after the scanner's own retry; does nothing when the day is already stored.
# No scan for the day (holiday, scanner skipped) -> exit 2, nothing written. A stored day is never rewritten.
# Read by GET /api/desk/ai-watchlist (signed in) -> /app/watchlist (user decision 2026-10-26).
#
# Install (one-off, not CI-managed):
#   sudo install -m 0644 /opt/nivesh-staging/repo/deploy/nivesh-staging/ai-watchlist.cron /etc/cron.d/nivesh-staging-ai-watchlist

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Asia/Kolkata
MAILTO=""

15 20 * * 1-5  root  /usr/bin/docker exec nivesh-staging-app-backend python -m scripts.build_ai_watchlist --skip-if-done >> /opt/nivesh-staging/logs/ai-watchlist.log 2>&1
15 22 * * 1-5  root  /usr/bin/docker exec nivesh-staging-app-backend python -m scripts.build_ai_watchlist --skip-if-done >> /opt/nivesh-staging/logs/ai-watchlist.log 2>&1
