# Multi-stage production frontend build.
#
# Stage 1 (builder): Node 20 — installs deps, runs craco build.
# Stage 2 (runtime): Nginx 1.25-alpine — serves static files only.
#
# REACT_APP_BACKEND_URL and PUBLIC_URL are baked into the JS bundle at build time.
# Pass as: docker build --build-arg REACT_APP_BACKEND_URL=http://<VM_IP> --build-arg PUBLIC_URL=/v2

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

ARG REACT_APP_BACKEND_URL
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL

# PUBLIC_URL tells CRA/craco the sub-path the app is served from.
# Webpack bakes this into asset src/href in index.html at build time.
ARG PUBLIC_URL=/v2
ENV PUBLIC_URL=$PUBLIC_URL

RUN apk add --no-cache python3 make g++ git

WORKDIR /app/frontend

# Dependencies in a stable layer
COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 600000

# Source code
COPY frontend/ ./

# Production build (craco handles webpack aliases)
RUN yarn build

# ── Stage 2: Nginx runtime ────────────────────────────────────────────────────
FROM nginx:1.25-alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Our config
COPY deploy/nivesh-app/nginx.conf /etc/nginx/conf.d/app.conf

# React build output
COPY --from=builder /app/frontend/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
