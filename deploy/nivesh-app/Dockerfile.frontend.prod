# Multi-stage production frontend build.
#
# Stage 1 (builder): Node 20 — installs deps, runs `yarn build:all` which
# produces two fully-isolated bundles:
#   - build/v2/  (REACT_APP_BUNDLE_TARGET=v2, PUBLIC_URL=/v2) → /v2/* SPA
#   - build/v3/  (REACT_APP_BUNDLE_TARGET=v3, PUBLIC_URL=/v3) → /v3/* SPA
# Each bundle has its own index.html and its own static/ tree; neither
# contains any code from the other.
#
# Stage 2 (runtime): Nginx 1.25-alpine — serves both static trees side-
# by-side under /v2/ and /v3/.
#
# Build-arg: REACT_APP_BACKEND_URL is baked into both bundles at build time.

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

ARG REACT_APP_BACKEND_URL
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL

RUN apk add --no-cache python3 make g++ git

WORKDIR /app/frontend

# Dependencies in a stable layer
COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 600000

# Source code
COPY frontend/ ./

# Two production bundles — PUBLIC_URL and BUILD_PATH are set per-script.
RUN yarn build:all

# ── Stage 2: Nginx runtime ────────────────────────────────────────────────────
FROM nginx:1.25-alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Our config
COPY deploy/nivesh-app/nginx.conf /etc/nginx/conf.d/app.conf

# React build outputs — V2 at /usr/share/nginx/html/v2, V3 at .../v3.
# nginx.conf serves /v2/* and /v3/* from their respective trees.
COPY --from=builder /app/frontend/build/v2 /usr/share/nginx/html/v2
COPY --from=builder /app/frontend/build/v3 /usr/share/nginx/html/v3

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
