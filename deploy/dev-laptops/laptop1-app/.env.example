# ─────────────────────────────────────────────────────────────────────────
# LAPTOP 1 (nivesh-app-vm replica) — copy to .env and fill in.
#   cp .env.example .env
# .env is git-ignored. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────
# Only 4 vars are strictly required to BOOT the backend (MONGO_URL, DB_NAME,
# POSTGRES_URL, REDIS_URL) — the compose file derives those from the pieces
# below. Everything else gates a feature: leave it blank and that feature is
# off, rather than the app failing to start.

# ═══ REQUIRED ════════════════════════════════════════════════════════════

# ── Laptop 2's LAN IP — the single cross-laptop wiring point ─────────────
# Find it ON LAPTOP 2 with:
#   Windows:  ipconfig | findstr IPv4
#   WSL/Linux: ip route get 1.1.1.1 | awk '{print $7; exit}'
# Give laptop 2 a static DHCP lease on your router so this never moves.
NIDP_HOST=
NIDP_EDGE_PORT=8080

# ── Shared secrets with laptop 2 ─────────────────────────────────────────
# These MUST be byte-identical to laptop 2's .env or every NIDP call 401s.
NIDP_DAAS_INTERNAL_TOKEN=
NIDP_QUERY_API_TOKEN=

# ── Local datastore credentials (any values; they create the local DBs) ──
PI_POSTGRES_USER=nivesh
# REQUIRED
PI_POSTGRES_PASSWORD=
PI_POSTGRES_DB=portfolio_ingestion
PI_MONGO_USER=root
# REQUIRED
PI_MONGO_PASSWORD=
PI_MONGO_DB=portfolio_ingestion
MONGO_DB=nivesh_local
# REQUIRED
PI_REDIS_PASSWORD=

# ═══ PUBLIC URL ══════════════════════════════════════════════════════════
# What the browser reaches this laptop on. BAKED INTO THE FRONTEND BUILDS —
# change it and you must rebuild:
#   docker compose -f docker-compose.app.yml build app-frontend app-frontend-v5
#
# Through the cloudflared tunnel:   https://dev.niveshcopilot.com
# Straight to the laptop:           http://localhost:3000
APP_PUBLIC_URL=https://dev.niveshcopilot.com

# true only when reached over HTTPS (i.e. via the tunnel). If you browse
# http://localhost:3000 directly with this set to true, login cookies are
# silently dropped and you will not stay signed in.
COOKIE_SECURE=true

# ── OPENAI_API_KEY — REQUIRED TO BOOT, not optional ──────────────────────
# backend/deps.py:41 constructs AIEngine(OPENAI_API_KEY) at IMPORT time, so
# an unset value crashes the backend before it serves anything:
#
#   File "/app/backend/deps.py", line 41, in <module>
#       ai_engine = AIEngine(OPENAI_API_KEY)
#   openai.OpenAIError: Missing credentials. Please pass an `api_key` ...
#
# Any non-empty string satisfies the constructor, so a placeholder is enough
# to BOOT — but every LLM-backed feature (copilot chat, classification,
# embeddings) will 401 until you put a real key here.
#
# The project has an OpenAI licence only; there is no Anthropic key, so
# Claude-backed paths do nothing regardless of what you set.
# REQUIRED
OPENAI_API_KEY=

# ═══ OPTIONAL — each gates one feature ═══════════════════════════════════

# Email / magic-link login. Without SMTP you cannot receive a login link —
# create a user directly in Mongo instead, or point at a local catcher
# (e.g. Mailhog on host.docker.internal:1025).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google OAuth / Gmail sync. Redirect URI must be registered in the Google
# console as <APP_PUBLIC_URL>/api/oauth/gmail/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CAS statement parsing. Blank = the in-house casparser wrapper only.
CASPARSER_API_KEY=

# PII encryption. Generate one: openssl rand -hex 32
# A default is used if blank, which is fine locally but never for real data.
PI_PAN_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=

# Admin/webhook tokens for local admin endpoints.
PI_ADMIN_TOKEN=local-dev-admin-token
PI_WEBHOOK_SECRET=local-dev-webhook-secret

# ═══ PORTS ═══════════════════════════════════════════════════════════════
APP_EDGE_PORT=3000             # cloudflared origin — do not change casually
APP_BACKEND_PORT=8001
APP_PG_PORT=5432
APP_MONGO_PORT=27017
APP_REDIS_PORT=6379

LOG_LEVEL=info
