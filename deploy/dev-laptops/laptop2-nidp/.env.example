# ─────────────────────────────────────────────────────────────────────────
# LAPTOP 2 (nidp-stack-vm replica) — copy to .env and fill in.
#   cp .env.example .env
# .env is git-ignored. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────
# Variable names mirror the live VM's /opt/nidp/nidp.env so anything you
# copy from there drops straight in.

# ── Postgres / TimescaleDB ───────────────────────────────────────────────
# These create the local DB. They do NOT need to match staging's credentials
# — the restore uses --no-owner so roles are irrelevant.
NIDP_PG_USER=nidp
# REQUIRED — pick anything for local dev
NIDP_PG_PASSWORD=
NIDP_PG_DB=nidp
NIDP_PG_PORT=5433

# Restore/CPU tuning. Raise shared_buffers if the laptop has RAM to spare;
# 1GB is a safe default for a 16GB machine also running Docker Desktop.
PG_SHARED_BUFFERS=1GB
PG_MAINT_WORK_MEM=512MB

# ── Service tokens ───────────────────────────────────────────────────────
# Shared secrets between the APIs and their callers. Generate fresh ones for
# local dev — do NOT reuse the production values:
#   openssl rand -hex 32
# REQUIRED
NIDP_DAAS_INTERNAL_TOKEN=
# REQUIRED
NIDP_QUERY_API_TOKEN=

# ⚠️  Laptop 1's backend must use these SAME two values, or every NIDP call
#     from the app returns 401.

# ── Object storage (MinIO stands in for GCS) ─────────────────────────────
NIDP_STORAGE_BACKEND=s3
MINIO_ROOT_USER=nidp-dev
# REQUIRED — min 8 chars
MINIO_ROOT_PASSWORD=
NIDP_S3_BUCKET=nidp-raw
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Event bus ────────────────────────────────────────────────────────────
# 'local' matches the live VM. Only set to kafka if you start the `kafka`
# profile, and note the VM's own env file says Kafka is dead.
NIDP_EVENT_BUS=local

# ── External APIs (only needed if you run the feed scheduler) ────────────
# OpenAI drives announcement_classifier, the document_parser embedder and
# the vision fallback. NOTE: the project is OpenAI-only — there is no
# Anthropic licence, so the Claude-era services produce nothing.
OPENAI_API_KEY=

# Screener.in session cookie — required by nse_financials + backfill.
# Get from: screener.in -> DevTools -> Application -> Cookies -> sessionid
# Expires every 30-60 days.
SCREENER_SESSION_COOKIE=

# FRED (macro series). Free key from fred.stlouisfed.org.
FRED_API_KEY=

# ── Main-app Postgres (for portfolio_*_sync jobs) ────────────────────────
# Points BACK at laptop 1. Leave blank to skip those jobs.
#   postgresql://user:pass@<LAPTOP1_LAN_IP>:5432/portfolio_ingestion
NIVESH_POSTGRES_URL=

# ── AI tier (faster-whisper ASR for earnings calls) ──────────────────────
# cpu/int8 is right for a laptop without CUDA. Models download on first use
# into the nidp-whisper-models volume (~500MB for 'small').
# Options: tiny | base | small | medium | large-v3  (bigger = slower)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL=small

# ── Observability ────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
# REQUIRED
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3001             # 3001 not 3000 — laptop 1 owns 3000
PROM_PORT=9090
LOKI_PORT=3100
ALERTMANAGER_PORT=9093
NODE_EXPORTER_PORT=9100

# ── Ports ────────────────────────────────────────────────────────────────
NIDP_EDGE_PORT=8080           # nginx: /daas /query /grafana
NIDP_DAAS_PORT=8083
NIDP_QUERY_PORT=8090
NIDP_REDIS_PORT=6380

LOG_LEVEL=info
