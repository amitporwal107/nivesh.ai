      "title": "Component Crash Rate — Production",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 6 },
      "datasource": { "type": "grafana-sentry-datasource", "uid": "sentry" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 12, "gradientMode": "opacity", "spanNulls": false },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-sentry-datasource", "uid": "sentry" },
