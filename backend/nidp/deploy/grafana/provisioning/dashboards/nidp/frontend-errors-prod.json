  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "grafana-sentry-datasource", "name": "Sentry", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "NiveshCopilot V5 — PRODUCTION frontend error monitoring via Sentry",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Staging Dashboard",
      "url": "/grafana/d/v5-frontend-errors-staging",
      "type": "link",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [

    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "## 🔴 PRODUCTION — NiveshCopilot V5 Frontend\nFiltered to `environment:production`. Switch to the **Staging** dashboard via the link above."
      }
    },

    {
      "id": 1,
      "type": "stat",
      "title": "Component Crashes (24h)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 2 },
      "datasource": { "type": "grafana-sentry-datasource", "uid": "sentry" },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-sentry-datasource", "uid": "sentry" },
          "queryType": "issues",
          "query": "is:unresolved tags[source]:component environment:production",
          "projectIds": []
        }
      ]
    },

    {
      "id": 2,
      "type": "stat",
