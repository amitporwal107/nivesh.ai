    {
      "id": 8,
      "type": "table",
      "title": "Top Issues — Production",
      "description": "Unresolved component crashes sorted by event count. Click a row to open the Sentry issue.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "grafana-sentry-datasource", "uid": "sentry" },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Events", "desc": true }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" }, "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Title" },
            "properties": [{ "id": "custom.width", "value": 420 }]
          },
          {
            "matcher": { "id": "byName", "options": "Events" },
            "properties": [
              { "id": "custom.width", "value": 100 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 5 },
                    { "color": "red", "value": 20 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "grafana-sentry-datasource", "uid": "sentry" },
          "queryType": "issues",
          "query": "is:unresolved environment:production",
          "projectIds": []
        }
      ]
