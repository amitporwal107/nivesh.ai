      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "grafana-sentry-datasource", "uid": "sentry" },
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
