# NIDP staging service environment — fill this in on the VM at /opt/nidp-staging/nidp.env
# Mode: 0600, owner nidp-staging:nidp-staging.
#
# Mirrors nidp.env.example but points at the staging TimescaleDB (port 5434)
# and uses a separate nidp_staging database so prod and staging never share data.

# ── NIDP Postgres (TimescaleDB staging container on the same VM) ──────
# docker-compose.staging.yml binds it to 127.0.0.1:5434 for native processes.
NIDP_PG_USER=nidp_staging
NIDP_PG_PASSWORD=CHANGEME_STAGING
NIDP_PG_DB=nidp_staging
NIDP_POSTGRES_URL=postgresql://nidp_staging:CHANGEME_STAGING@localhost:5434/nidp_staging

# Nivesh main-app Postgres — required by portfolio_holdings_sync.
# Point at the STAGING Nivesh Postgres if available; otherwise omit.
NIVESH_POSTGRES_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB

# ── NIDP home directory (used by run_service.sh + raw-archive path) ───
NIDP_HOME=/opt/nidp-staging

# ── Event bus (always local since Kafka is dead) ──────────────────────
NIDP_EVENT_BUS=local

# ── Telegram alerts ───────────────────────────────────────────────────
# Use a separate bot/chat for staging so alerts don't pollute prod channels.
NIDP_TELEGRAM_BOT_TOKEN=
NIDP_TELEGRAM_CHAT_ID=

# ── Optional API keys per service ─────────────────────────────────────
# FRED_API_KEY=
# CLAUDE_API_KEY=

# ── Staging query API ─────────────────────────────────────────────────
# External hostname once Cloudflare CNAME is live.
NIDP_QUERY_API_BASE_URL=https://data.staging.niveshcopilot.com
NIDP_QUERY_API_TOKEN=CHANGEME_STAGING

# ── Runtime tuning ────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
TZ=Asia/Kolkata
