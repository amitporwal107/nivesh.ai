# NIDP service environment — fill this in on the VM at /opt/nidp/nidp.env
# Mode: 0600, owner nidp:nidp.

# ── NIDP Postgres (TimescaleDB in Docker on the same VM) ──────────
# docker-compose.prod.yml binds it to 127.0.0.1:5433 for native processes.
NIDP_PG_USER=nidp
NIDP_PG_PASSWORD=CHANGEME
NIDP_PG_DB=nidp
NIDP_POSTGRES_URL=postgresql://nidp:CHANGEME@localhost:5433/nidp

# Nivesh main-app Postgres — required by portfolio_holdings_sync to read
# portfolio_snapshot_master / portfolio_snapshot_holdings / client_user_map.
# The container binds 127.0.0.1:5432 on the VM (docker-compose.prod.yml).
# Credentials come from /opt/nivesh/.env.prod (POSTGRES_USER/PASSWORD/DB).
NIVESH_POSTGRES_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB
# ↑ fill in actual values from /opt/nivesh/.env.prod

# ── Event bus (always local since Kafka is dead) ──────────────────
NIDP_EVENT_BUS=local

# ── Telegram alerts (used by health_check.sh) ─────────────────────
NIDP_TELEGRAM_BOT_TOKEN=
NIDP_TELEGRAM_CHAT_ID=

# ── Optional API keys per service (only set the ones you need) ────
# FRED_API_KEY=
# CLAUDE_API_KEY=

# ── Screener.in Pro session cookie ───────────────────────────────────
# Required by nse_financials and bank_npa_patch to fetch NPA data for
# large banks (HDFCBANK, ICICIBANK, AXISBANK, SBIN, PNB, etc.).
# Without this, NPA fields remain null and bank_scoring falls back to
# the 4-pillar (no asset quality) model for those banks.
# Obtain from DevTools → Application → Cookies → screener.in → sessionid.
# Rotate when the cookie expires (typically 30-90 days).
# SCREENER_SESSION_COOKIE=

# ── Runtime tuning ────────────────────────────────────────────────
PYTHONUNBUFFERED=1
TZ=Asia/Kolkata
