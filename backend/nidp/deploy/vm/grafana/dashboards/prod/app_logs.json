  "refresh": "30s",
  "timezone": "Asia/Kolkata",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "hide": 0,
        "options": [
          {
            "text": "prod",
            "value": "nivesh-app-vm",
            "selected": true
          },
          {
            "text": "staging",
            "value": "nidp-stack-vm",
            "selected": false
          }
        ],
        "current": {
          "text": "prod",
          "value": "nivesh-app-vm"
        },
        "multi": false,
        "includeAll": false,
        "query": "prod : nivesh-app-vm,staging : nidp-stack-vm"
      },
