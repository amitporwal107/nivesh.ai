        "query": "nivesh-api,nidp-console,nidp-intelligence,nidp-nse-financials,nidp-mf-holdings,bhavcopy,index_close,fii_dii,bulk_deals,block_deals,delivery,corporate_actions,rbi_yields,fred_macro,nse_calendar,index_constituents,fno_bhavcopy,nse_financials,nse_financials.bank_npa_patch,nse_shareholding,nse_equity_master,price_adjuster,snapshot_builder,mf_analytics_engine,mf_category_ranking,technical_indicator_engine,fundamental_engine,corporate_announcements_nse,corporate_announcements_bse,announcement_classifier,document_parser,amfi_nav,amfi_circulars,mf_disclosure_snapshot,mf_holdings,mf_derived_refresh,bank_scoring,v3_scores_engine,analytics_refresh,amc_urls_drift_check,event_calendar,event_day_poller,d1_prep,intelligence,quality_gate,portfolio_holdings_sync,portfolio_transactions_sync,portfolio_goals_sync,intelligence_layer,portfolio_intelligence_sync,pra_engine,parquet_exporter,container_health,service_health,gate4"
      },
      {
        "name": "min_severity",
        "label": "Min Severity",
        "type": "custom",
        "hide": 0,
        "options": [
          {
            "text": "DEBUG",
            "value": "DEBUG",
            "selected": false
          },
          {
            "text": "INFO",
            "value": "INFO",
            "selected": true
          },
          {
            "text": "WARNING",
            "value": "WARNING",
            "selected": false
          },
          {
            "text": "ERROR",
            "value": "ERROR",
            "selected": false
          },
          {
            "text": "CRITICAL",
            "value": "CRITICAL",
            "selected": false
          }
        ],
        "current": {
          "text": "INFO",
          "value": "INFO"
        },
        "multi": false,
        "includeAll": false,
        "query": "DEBUG,INFO,WARNING,ERROR,CRITICAL"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Errors (1h)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "googlecloud-logging-datasource",
        "uid": "gcp-logging"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "logs",
          "projectId": "niveshdataintelligence",
          "queryText": "labels.\"compute.googleapis.com/resource_name\"=\"${env}\"\njsonPayload.log=~\"(?i)(\" [45][0-9][0-9] |error|Error)\"\nAND jsonPayload.service=~\"${service}\""
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Criticals (1h)",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "googlecloud-logging-datasource",
        "uid": "gcp-logging"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "logs",
          "projectId": "niveshdataintelligence",
          "queryText": "labels.\"compute.googleapis.com/resource_name\"=\"${env}\"\njsonPayload.log=~\"(?i)(critical|CRITICAL|500 |502 |503 )\"\nAND jsonPayload.service=~\"${service}\""
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Warnings (1h)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "googlecloud-logging-datasource",
        "uid": "gcp-logging"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "orange",
                "value": 50
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "logs",
          "projectId": "niveshdataintelligence",
          "queryText": "labels.\"compute.googleapis.com/resource_name\"=\"${env}\"\njsonPayload.log=~\"(?i)(warning|Warning|400 |401 |403 |404 )\"\nAND jsonPayload.service=~\"${service}\""
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total Entries (1h)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "googlecloud-logging-datasource",
        "uid": "gcp-logging"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "logs",
          "projectId": "niveshdataintelligence",
          "queryText": "labels.\"compute.googleapis.com/resource_name\"=\"${env}\""
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "GCP Cloud Logging \u2014 [${env}] \u2265 ${min_severity}",
      "description": "Centralized logs from Nivesh app (FastAPI) and NIDP services. Structured JSON, GCP trace-correlated.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 22
      },
      "datasource": {
        "type": "googlecloud-logging-datasource",
        "uid": "gcp-logging"
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "logs",
          "projectId": "niveshdataintelligence",
          "queryText": "labels.\"compute.googleapis.com/resource_name\"=\"${env}\""
        }
      ]
    },
    {
      "id": 20,
      "type": "logs",
      "title": "NIDP VM Logs \u2014 Loki (nidp-stack-vm local)",
      "description": "Logs shipped by Promtail from /opt/nidp/logs/ on nidp-stack-vm.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "NIDP-Loki"
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{filename=~\"/nidp/logs/.*\"} | json | severity >= `${min_severity}`"
        }
      ]
    }
  ]
}