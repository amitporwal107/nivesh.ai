{
  "annotations": { "list": [] },
  "description": "Full-stack environment map — Docker containers, REST services, cron jobs, DB health, and live logs for both nidp-stack-vm and nivesh-app-vm (prod).",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Feed Schedule", "url": "/grafana/d/nidp-prod-feeds", "type": "dashboards", "icon": "external link" },
    { "title": "Job Health",    "url": "/grafana/d/nidp-prod-jobs",  "type": "dashboards", "icon": "external link" },
    { "title": "DQ Chain",      "url": "/grafana/d/nidp-prod-dq",    "type": "dashboards", "icon": "external link" }
  ],
  "panels": [

    { "id": 1,  "type": "stat",  "title": "Total Containers",
      "gridPos": { "h": 4, "w": 4, "x": 0,  "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "blue", "mode": "fixed" } }, "overrides": [] },
      "targets": [{ "rawSql": "SELECT COUNT(DISTINCT container_name) FROM monitoring.container_health WHERE collected_at = (SELECT MAX(collected_at) FROM monitoring.container_health)", "format": "table", "refId": "A" }]
    },

    { "id": 2,  "type": "stat",  "title": "Running",
      "gridPos": { "h": 4, "w": 4, "x": 4,  "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green", "mode": "fixed" } }, "overrides": [] },
      "targets": [{ "rawSql": "SELECT COUNT(*) FROM monitoring.container_health WHERE collected_at = (SELECT MAX(collected_at) FROM monitoring.container_health) AND status = 'running'", "format": "table", "refId": "A" }]
    },

    { "id": 3,  "type": "stat",  "title": "Unhealthy / Stopped",
      "gridPos": { "h": 4, "w": 4, "x": 8,  "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "targets": [{ "rawSql": "SELECT COUNT(*) FROM monitoring.container_health WHERE collected_at = (SELECT MAX(collected_at) FROM monitoring.container_health) AND (status != 'running' OR health = 'unhealthy')", "format": "table", "refId": "A" }]
    },

    { "id": 4,  "type": "stat",  "title": "REST Services UP",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green", "mode": "fixed" } }, "overrides": [] },
      "targets": [{ "rawSql": "SELECT COUNT(*) FROM monitoring.v_latest_services WHERE is_up = true", "format": "table", "refId": "A" }]
    },

    { "id": 5,  "type": "stat",  "title": "REST Services DOWN",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "targets": [{ "rawSql": "SELECT COUNT(*) FROM monitoring.v_latest_services WHERE is_up = false OR is_up IS NULL", "format": "table", "refId": "A" }]
    },

    { "id": 6,  "type": "stat",  "title": "Feed Success Rate (24h)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 90 }, { "color": "green", "value": 98 }] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "targets": [{ "rawSql": "SELECT ROUND((COUNT(*) FILTER (WHERE status IN ('OK','GREEN')))::numeric / NULLIF(COUNT(*),0) * 100, 1) AS pct FROM nidp.job_log WHERE started_at >= NOW() - INTERVAL '24 hours'", "format": "table", "refId": "A" }]
    },

    { "id": 10, "type": "row", "title": "VM Map",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "collapsed": false
    },

    { "id": 11, "type": "stat", "title": "nidp-stack-vm — data.niveshcopilot.com",
      "description": "TimescaleDB · Grafana · DaaS API · Query API · Loki · Promtail · NIDP pipeline (28 ingesters)",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }
      },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "purple", "mode": "fixed" } }, "overrides": [] },
      "targets": [
        { "rawSql": "SELECT 'Running' AS metric, COUNT(*) AS value FROM monitoring.container_health WHERE collected_at=(SELECT MAX(collected_at) FROM monitoring.container_health) AND vm='nidp-stack-vm' AND status='running' UNION ALL SELECT 'Unhealthy', COUNT(*) FROM monitoring.container_health WHERE collected_at=(SELECT MAX(collected_at) FROM monitoring.container_health) AND vm='nidp-stack-vm' AND (status!='running' OR health='unhealthy')", "format": "table", "refId": "A" }
      ]
    },

    { "id": 12, "type": "stat", "title": "nivesh-app-vm — niveshcopilot.com  (34.47.250.214)",
      "description": "MongoDB · PostgreSQL · Redis · Backend FastAPI · Frontend nginx · Staging stack mirror",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }
      },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "orange", "mode": "fixed" } }, "overrides": [] },
      "targets": [
        { "rawSql": "SELECT 'Services UP' AS metric, COUNT(*) AS value FROM monitoring.v_latest_services WHERE vm='nivesh-app-vm' AND is_up=true UNION ALL SELECT 'Services DOWN', COUNT(*) FROM monitoring.v_latest_services WHERE vm='nivesh-app-vm' AND (is_up=false OR is_up IS NULL)", "format": "table", "refId": "A" }
      ]
    },

    { "id": 20, "type": "row", "title": "Docker Containers — Current Status",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "collapsed": false
    },

    { "id": 21, "type": "table", "title": "All Containers — Resource & Health",
      "description": "Refreshes every 60s. Container CPU, memory, ports, HTTP health endpoint and status, uptime.",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 11 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "displayName": "status_rank", "desc": false }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "status" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "mappings", "value": [{ "type": "value", "options": { "running": { "text": "RUNNING", "color": "green" } } }, { "type": "value", "options": { "exited": { "text": "EXITED", "color": "red" } } }, { "type": "value", "options": { "dead": { "text": "DEAD", "color": "red" } } }, { "type": "value", "options": { "restarting": { "text": "RESTARTING", "color": "orange" } } }, { "type": "value", "options": { "paused": { "text": "PAUSED", "color": "yellow" } } }] }] },
          { "matcher": { "id": "byName", "options": "health" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "mappings", "value": [{ "type": "value", "options": { "healthy": { "text": "HEALTHY", "color": "green" } } }, { "type": "value", "options": { "unhealthy": { "text": "UNHEALTHY", "color": "red" } } }, { "type": "value", "options": { "starting": { "text": "STARTING", "color": "yellow" } } }, { "type": "value", "options": { "none": { "text": "—", "color": "text" } } }] }] },
          { "matcher": { "id": "byName", "options": "environment" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "mappings", "value": [{ "type": "value", "options": { "prod": { "text": "PROD", "color": "purple" } } }, { "type": "value", "options": { "staging": { "text": "STAGING", "color": "orange" } } }, { "type": "value", "options": { "infra": { "text": "INFRA", "color": "blue" } } }] }] },
          { "matcher": { "id": "byName", "options": "http_status" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 500 }] } }, { "id": "color", "value": { "mode": "thresholds" } }] },
          { "matcher": { "id": "byName", "options": "cpu_%" }, "properties": [{ "id": "unit", "value": "percent" }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "basic" } }, { "id": "min", "value": 0 }, { "id": "max", "value": 100 }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] } }, { "id": "color", "value": { "mode": "thresholds" } }] },
          { "matcher": { "id": "byName", "options": "mem_MB" }, "properties": [{ "id": "unit", "value": "decmbytes" }] },
          { "matcher": { "id": "byName", "options": "limit_MB" }, "properties": [{ "id": "unit", "value": "decmbytes" }] },
          { "matcher": { "id": "byName", "options": "uptime_s" }, "properties": [{ "id": "unit", "value": "s" }] },
          { "matcher": { "id": "byName", "options": "resp_ms" }, "properties": [{ "id": "unit", "value": "ms" }] },
          { "matcher": { "id": "byName", "options": "status_rank" }, "properties": [{ "id": "custom.hidden", "value": true }] }
        ]
      },
      "targets": [{
        "rawSql": "SELECT CASE WHEN status!='running' OR health='unhealthy' THEN 0 ELSE 1 END AS status_rank, COALESCE(vm,'nidp-stack-vm') AS vm, environment, container_name, container_image AS image, status, health, ROUND(COALESCE(cpu_percent,0)::numeric,1) AS \"cpu_%\", ROUND(COALESCE(mem_usage_mb,0)::numeric,0) AS mem_MB, ROUND(COALESCE(mem_limit_mb,0)::numeric,0) AS limit_MB, COALESCE(ports,'—') AS ports, COALESCE(http_url,'—') AS http_url, COALESCE(http_status_code::text,'—') AS http_status, COALESCE(http_response_ms::text,'—') AS resp_ms, COALESCE(uptime_seconds,0) AS uptime_s, collected_at FROM monitoring.v_latest_containers ORDER BY status_rank, vm, environment, container_name",
        "format": "table", "refId": "A"
      }]
    },

    { "id": 30, "type": "row", "title": "CPU & Memory Trends (Last 1h)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },

    { "id": 31, "type": "timeseries", "title": "CPU % — Top Containers (1h)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{
        "rawSql": "SELECT collected_at AS time, container_name AS metric, ROUND(cpu_percent::numeric,2) AS value FROM monitoring.container_health WHERE collected_at >= now()-interval'1 hour' AND cpu_percent IS NOT NULL AND cpu_percent > 0 AND container_name IN (SELECT container_name FROM monitoring.container_health WHERE collected_at >= now()-interval'1 hour' AND cpu_percent IS NOT NULL GROUP BY container_name ORDER BY AVG(cpu_percent) DESC LIMIT 10) ORDER BY collected_at",
        "format": "time_series", "refId": "A"
      }]
    },

    { "id": 32, "type": "timeseries", "title": "Memory MB — Top Containers (1h)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "min": 0, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{
        "rawSql": "SELECT collected_at AS time, container_name AS metric, ROUND(mem_usage_mb::numeric,1) AS value FROM monitoring.container_health WHERE collected_at >= now()-interval'1 hour' AND mem_usage_mb IS NOT NULL AND mem_usage_mb > 0 AND container_name IN (SELECT container_name FROM monitoring.container_health WHERE collected_at >= now()-interval'1 hour' AND mem_usage_mb IS NOT NULL GROUP BY container_name ORDER BY AVG(mem_usage_mb) DESC LIMIT 10) ORDER BY collected_at",
        "format": "time_series", "refId": "A"
      }]
    },

    { "id": 40, "type": "row", "title": "REST Services & HTTP Endpoints",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "collapsed": false
    },

    { "id": 41, "type": "table", "title": "REST Services — Latest Health Check",
      "description": "Probed every minute from nidp-stack-vm. HTTPS probes cross-check Nivesh App VM externally.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 37 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true,
        "sortBy": [{ "displayName": "is_up", "desc": false }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "is_up" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "mappings", "value": [{ "type": "value", "options": { "true": { "text": "UP", "color": "green" } } }, { "type": "value", "options": { "false": { "text": "DOWN", "color": "red" } } }] }] },
          { "matcher": { "id": "byName", "options": "http_status" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 500 }] } }, { "id": "color", "value": { "mode": "thresholds" } }] },
          { "matcher": { "id": "byName", "options": "environment" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "mappings", "value": [{ "type": "value", "options": { "prod": { "text": "PROD", "color": "purple" } } }, { "type": "value", "options": { "staging": { "text": "STAGING", "color": "orange" } } }] }] },
          { "matcher": { "id": "byName", "options": "response_ms" }, "properties": [{ "id": "unit", "value": "ms" }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "basic" } }, { "id": "min", "value": 0 }, { "id": "max", "value": 2000 }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 500 }, { "color": "red", "value": 1500 }] } }, { "id": "color", "value": { "mode": "thresholds" } }] }
        ]
      },
      "targets": [{
        "rawSql": "SELECT vm, service_name, environment, url, is_up::text, http_status, COALESCE(response_ms,0) AS response_ms, COALESCE(error_msg,'') AS error, collected_at AS last_checked FROM monitoring.v_latest_services ORDER BY is_up ASC NULLS FIRST, vm, service_name",
        "format": "table", "refId": "A"
      }]
    },

    { "id": 42, "type": "timeseries", "title": "Service Response Times (Last 1h)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 49 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean", "max"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "custom": { "fillOpacity": 5 } }, "overrides": [] },
      "targets": [{
        "rawSql": "SELECT collected_at AS time, service_name AS metric, response_ms AS value FROM monitoring.service_health WHERE collected_at >= now()-interval'1 hour' AND is_up=true AND response_ms IS NOT NULL ORDER BY collected_at",
        "format": "time_series", "refId": "A"
      }]
    },

    { "id": 43, "type": "timeseries", "title": "Service Availability (Last 24h)",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 57 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["min", "mean"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 20, "drawStyle": "bars" } }, "overrides": [] },
      "targets": [{
        "rawSql": "SELECT time_bucket('5 minutes', collected_at) AS time, service_name AS metric, ROUND(AVG(CASE WHEN is_up THEN 100.0 ELSE 0.0 END)::numeric,1) AS value FROM monitoring.service_health WHERE collected_at >= now()-interval'24 hours' GROUP BY time, service_name ORDER BY time",
        "format": "time_series", "refId": "A"
      }]
    },

    { "id": 50, "type": "row", "title": "Cron Jobs — Schedule & Last Run",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 64 },
      "collapsed": false
    },

    { "id": 51, "type": "table", "title": "All Scheduled Jobs (both VMs)",
      "description": "Static registry joined with nidp.source_registry for NIDP feeds. FAILED and overdue jobs sort to the top.",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 65 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "cellHeight": "sm", "footer": { "enablePagination": true, "show": false }, "showHeader": true },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "last_status" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "mappings", "value": [{ "type": "value", "options": { "OK": { "color": "green" } } }, { "type": "value", "options": { "FAILED": { "color": "red" } } }, { "type": "value", "options": { "PARTIAL": { "color": "orange" } } }, { "type": "value", "options": { "NEVER": { "color": "gray", "text": "NEVER RUN" } } }, { "type": "value", "options": { "SKIPPED": { "color": "blue" } } }] }] },
          { "matcher": { "id": "byName", "options": "hours_since" }, "properties": [{ "id": "unit", "value": "h" }, { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 26 }, { "color": "red", "value": 72 }] } }, { "id": "color", "value": { "mode": "thresholds" } }] },
          { "matcher": { "id": "byName", "options": "last_error" }, "properties": [{ "id": "custom.width", "value": 400 }] },
          { "matcher": { "id": "byName", "options": "sort_key" }, "properties": [{ "id": "custom.hidden", "value": true }] }
        ]
      },
      "targets": [{
        "rawSql": "SELECT CASE WHEN COALESCE(sr.last_run_status,'NEVER')='FAILED' THEN 0 WHEN sr.last_run_at IS NULL THEN 1 WHEN COALESCE(sr.last_run_status,'NEVER')='PARTIAL' THEN 2 ELSE 3 END AS sort_key, cr.vm, cr.job_name, cr.schedule_ist AS schedule, COALESCE(sr.last_run_status,'NEVER') AS last_status, sr.last_run_at, ROUND((EXTRACT(EPOCH FROM(NOW()-sr.last_run_at))/3600)::numeric,1) AS hours_since, LEFT(COALESCE(sr.last_error,''),300) AS last_error FROM monitoring.cron_registry cr LEFT JOIN nidp.source_registry sr ON sr.ingester=cr.job_name WHERE cr.enabled=TRUE ORDER BY sort_key, cr.vm, cr.job_name",
        "format": "table", "refId": "A"
      }]
    },

    { "id": 60, "type": "row", "title": "Infrastructure Tools",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 85 },
      "collapsed": false
    },

    { "id": 61, "type": "table", "title": "Infrastructure Services — Ports & URLs",
      "description": "Static inventory of all infra tools running on both VMs.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 86 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "cellHeight": "sm", "showHeader": true },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "is_up" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "mappings", "value": [{ "type": "value", "options": { "true": { "text": "UP", "color": "green" } } }, { "type": "value", "options": { "false": { "text": "DOWN", "color": "red" } } }] }] }
        ]
      },
      "targets": [{
        "rawSql": "SELECT v.vm, s.service_name AS tool, s.url AS health_url, s.is_up::text, s.response_ms AS resp_ms, s.http_status, s.collected_at AS last_checked FROM monitoring.v_latest_services s JOIN monitoring.vm_inventory v ON v.vm_name=s.vm WHERE s.service_name IN ('grafana','loki','promtail','prometheus','minio','timescaledb-prod','timescaledb-stg','daas-api','query-api','nginx') ORDER BY v.vm, s.service_name",
        "format": "table", "refId": "A"
      }]
    },

    { "id": 70, "type": "row", "title": "Database Health — TimescaleDB",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 96 },
      "collapsed": false
    },

    { "id": 71, "type": "stat", "title": "Active Connections",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 97 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 150 }] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "targets": [{ "rawSql": "SELECT count(*) FROM pg_stat_activity WHERE datname=current_database()", "format": "table", "refId": "A" }]
    },

    { "id": 72, "type": "stat", "title": "Active Queries",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 97 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 20 }, { "color": "red", "value": 50 }] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "targets": [{ "rawSql": "SELECT count(*) FROM pg_stat_activity WHERE datname=current_database() AND state='active' AND query NOT ILIKE '%pg_stat_activity%'", "format": "table", "refId": "A" }]
    },

    { "id": 73, "type": "stat", "title": "DB Size",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 97 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] },
      "targets": [{ "rawSql": "SELECT pg_database_size(current_database())", "format": "table", "refId": "A" }]
    },

    { "id": 74, "type": "stat", "title": "Hypertables",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 97 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "blue", "mode": "fixed" } }, "overrides": [] },
      "targets": [{ "rawSql": "SELECT count(*) FROM timescaledb_information.hypertables", "format": "table", "refId": "A" }]
    },

    { "id": 75, "type": "stat", "title": "Replication Lag",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 97 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 60 }, { "color": "red", "value": 300 }] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "targets": [{ "rawSql": "SELECT COALESCE(EXTRACT(EPOCH FROM (now()-pg_last_xact_replay_timestamp()))::INT,0) AS lag_secs", "format": "table", "refId": "A" }]
    },

    { "id": 76, "type": "stat", "title": "Oldest Open Transaction",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 97 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 60 }, { "color": "red", "value": 300 }] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "targets": [{ "rawSql": "SELECT COALESCE(MAX(EXTRACT(EPOCH FROM (now()-xact_start)))::INT,0) AS oldest_txn_secs FROM pg_stat_activity WHERE datname=current_database() AND xact_start IS NOT NULL AND state!='idle'", "format": "table", "refId": "A" }]
    },

    { "id": 77, "type": "table", "title": "pg_stat_activity — Active Queries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 101 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "cellHeight": "sm", "showHeader": true },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "duration_s" }, "properties": [{ "id": "unit", "value": "s" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 60 }] } }, { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "color", "value": { "mode": "thresholds" } }] }
        ]
      },
      "targets": [{ "rawSql": "SELECT pid, usename AS user, state, ROUND(EXTRACT(EPOCH FROM (now()-query_start))::numeric,1) AS duration_s, LEFT(query,120) AS query FROM pg_stat_activity WHERE datname=current_database() AND state!='idle' AND query NOT ILIKE '%pg_stat_activity%' ORDER BY duration_s DESC LIMIT 20", "format": "table", "refId": "A" }]
    },

    { "id": 80, "type": "row", "title": "Active Alerts",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 109 },
      "collapsed": false
    },

    { "id": 81, "type": "table", "title": "Grafana Alert Events (Last 24h)",
      "description": "Alerts fired by Grafana alerting rules and stored via the webhook receiver.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 110 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "NIDP-TimescaleDB" },
      "options": { "cellHeight": "sm", "showHeader": true, "sortBy": [{ "displayName": "received_at", "desc": true }] },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "state" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "mappings", "value": [{ "type": "value", "options": { "firing": { "text": "FIRING", "color": "red" } } }, { "type": "value", "options": { "resolved": { "text": "RESOLVED", "color": "green" } } }] }] },
          { "matcher": { "id": "byName", "options": "severity" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "mappings", "value": [{ "type": "value", "options": { "critical": { "color": "red" } } }, { "type": "value", "options": { "warning": { "color": "orange" } } }] }] }
        ]
      },
      "targets": [{ "rawSql": "SELECT received_at, alert_name, state, severity, COALESCE(environment,'—') AS environment, labels::text AS labels FROM monitoring.alert_events WHERE received_at >= now()-interval'24 hours' ORDER BY received_at DESC LIMIT 50", "format": "table", "refId": "A" }]
    },

    { "id": 90, "type": "row", "title": "Live Logs (Loki)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 118 },
      "collapsed": false
    },

    { "id": 91, "type": "logs", "title": "Live Service Logs",
      "description": "Stream from Loki. Use the service variable to filter. Requires nidp-loki + nidp-promtail running.",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 119 },
      "datasource": { "type": "loki", "uid": "NIDP-Loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{
        "expr": "{vm=\"nidp-stack-vm\", job=~\"$log_service\"} |= \"$log_search\"",
        "refId": "A",
        "queryType": "range"
      }]
    }

  ],

