      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "NIDP-TimescaleDB"
          },
          "format": "table",
          "rawSql": "SELECT alert_name, severity, environment, state, received_at, EXTRACT(EPOCH FROM (now()-received_at))::int||'s' AS firing_for FROM monitoring.alert_events WHERE state='firing' ORDER BY CASE severity WHEN 'critical' THEN 1 WHEN 'warning' THEN 2 ELSE 3 END, received_at ASC LIMIT 50",
          "refId": "A"
        }
      ],
      "title": "\ud83d\udea8 Active Alerts \u2014 sorted by severity then firing duration",
      "type": "table"
