      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "NIDP-TimescaleDB"
          },
          "format": "table",
          "rawSql": "SELECT\n  CASE environment\n    WHEN 'prod'    THEN 'prod'\n    WHEN 'staging' THEN 'staging'\n    ELSE environment\n  END AS env,\n  container_name,\n  CASE container_name\n    WHEN 'nidp-grafana'          THEN 'Monitoring dashboards UI'\n    WHEN 'nidp-loki'             THEN 'Log aggregation store'\n    WHEN 'nidp-minio'            THEN 'Object storage (S3-compatible)'\n    WHEN 'nidp-prometheus'       THEN 'Metrics scraper + alert rules'\n    WHEN 'nidp-promtail'         THEN 'Log shipper \u2192 Loki'\n    WHEN 'nidp-redis'            THEN 'In-memory cache / pub-sub broker'\n    WHEN 'nidp-redpanda'         THEN 'Kafka-compatible event stream'\n    WHEN 'nidp-schema-registry'  THEN 'Schema registry for Redpanda topics'\n    WHEN 'nidp-postgres'         THEN 'Primary NIDP TimescaleDB (prod, port 5433)'\n    WHEN 'nidp-alertmanager'     THEN 'Alert routing + webhook delivery'\n    WHEN 'nidp-node-exporter'    THEN 'Host metrics exporter \u2192 Prometheus'\n    WHEN 'nidp-daas-api-staging' THEN 'Staging Data-as-a-Service API'\n    WHEN 'nidp-postgres-staging' THEN 'Staging NIDP TimescaleDB (port 5434)'\n    ELSE container_name\n  END AS purpose,\n  status,\n  ROUND(cpu_percent,1) AS \"cpu %\",\n  ROUND(mem_usage_mb,0) AS \"mem MB\",\n  FLOOR(uptime_seconds/3600)||'h' AS uptime\nFROM monitoring.v_latest_containers\nORDER BY\n  CASE WHEN status != 'running' THEN 0 ELSE 1 END,\n  environment,\n  container_name",
          "refId": "A"
        }
      ],
      "title": "Container Health \u2014 all environments",
      "type": "table"
    },
