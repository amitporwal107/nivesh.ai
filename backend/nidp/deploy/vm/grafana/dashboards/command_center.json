      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "NIDP-TimescaleDB"
          },
          "format": "table",
          "rawSql": "SELECT\n  CASE environment\n    WHEN 'prod'    THEN 'prod'\n    WHEN 'staging' THEN 'staging'\n    ELSE environment\n  END AS env,\n  vm AS host_vm,\n  service_name,\n  CASE service_name\n    WHEN 'nginx'               THEN 'Reverse proxy \u00b7 TLS terminator (nidp-stack-vm)'\n    WHEN 'grafana'             THEN 'Monitoring dashboards (port 3000)'\n    WHEN 'daas-api'            THEN 'NIDP Data-as-a-Service REST API (port 8083)'\n    WHEN 'query-api'           THEN 'SQL query proxy for Grafana / BI tools (port 8090)'\n    WHEN 'loki'                THEN 'Log aggregation store (port 3100)'\n    WHEN 'promtail'            THEN 'Log shipper \u2192 Loki (port 9080)'\n    WHEN 'prometheus'          THEN 'Metrics scraper + alert TSDB (port 9090)'\n    WHEN 'minio'               THEN 'Object storage \u2014 S3-compatible (port 9001)'\n    WHEN 'timescaledb-prod'    THEN 'Primary NIDP TimescaleDB (port 5433)'\n    WHEN 'timescaledb-stg'     THEN 'Staging NIDP TimescaleDB (port 5434)'\n    WHEN 'frontend-prod'       THEN 'Nivesh.ai V2 React frontend (prod)'\n    WHEN 'backend-prod'        THEN 'Nivesh.ai FastAPI + Copilot backend (prod)'\n    WHEN 'frontend-v5-prod'    THEN 'Nivesh.ai V5 Vite/React frontend (prod)'\n    WHEN 'frontend-staging'    THEN 'Nivesh.ai V2 React frontend (staging)'\n    WHEN 'backend-staging'     THEN 'Nivesh.ai FastAPI + Copilot backend (staging)'\n    WHEN 'frontend-v5-staging' THEN 'Nivesh.ai V5 Vite/React frontend (staging)'\n    ELSE service_name\n  END AS purpose,\n  is_up,\n  COALESCE(response_ms::text || ' ms', '\u2014') AS latency,\n  COALESCE(error_msg, '') AS error\nFROM monitoring.v_latest_services\nORDER BY\n  CASE WHEN is_up=false OR is_up IS NULL THEN 0 ELSE 1 END,\n  environment,\n  service_name",
          "refId": "A"
        }
      ],
      "title": "REST Service Health \u2014 all environments",
      "type": "table"
    },
