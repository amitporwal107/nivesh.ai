    {
      "datasource": {"type": "postgres", "uid": "NIDP-TimescaleDB"},
      "description": "Last run per ingester — green=OK, red=FAILED, yellow=PARTIAL.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "auto",
            "filterable": true
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green"}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "status"},
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {"mode": "basic", "type": "color-background"}
              },
              {
                "id": "mappings",
                "value": [
                  {"type": "value", "options": {"OK": {"color": "rgba(50, 172, 45, 0.97)", "index": 0}}},
                  {"type": "value", "options": {"GREEN": {"color": "rgba(50, 172, 45, 0.97)", "index": 1}}},
                  {"type": "value", "options": {"FAILED": {"color": "rgba(245, 54, 54, 0.9)", "index": 2}}},
                  {"type": "value", "options": {"PARTIAL": {"color": "rgba(237, 129, 40, 0.89)", "index": 3}}},
                  {"type": "value", "options": {"SKIPPED": {"color": "rgba(150, 150, 150, 0.7)", "index": 4}}}
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "duration_ms"},
            "properties": [{"id": "unit", "value": "ms"}]
          },
          {
            "matcher": {"id": "byName", "options": "rows_inserted"},
            "properties": [{"id": "unit", "value": "short"}]
          }
        ]
      },
      "gridPos": {"h": 12, "w": 16, "x": 0, "y": 4},
      "id": 6,
      "options": {
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "started_at"}]
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "NIDP-TimescaleDB"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (ingester) ingester, status, started_at, duration_ms, rows_inserted, error_message FROM nidp.job_log ORDER BY ingester, started_at DESC",
          "refId": "A"
        }
      ],
      "title": "Last run per ingester",
      "type": "table"
    },
    {
      "datasource": {"type": "postgres", "uid": "NIDP-TimescaleDB"},
