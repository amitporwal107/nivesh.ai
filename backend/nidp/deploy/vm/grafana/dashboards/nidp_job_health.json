        {
          "datasource": {"type": "postgres", "uid": "NIDP-TimescaleDB"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (count(*) FILTER (WHERE status IN ('OK','GREEN')))::float / NULLIF(count(*),0) * 100 AS success_rate_pct FROM nidp.job_log WHERE started_at >= NOW() - INTERVAL '24 hours'",
          "refId": "A"
        }
      ],
      "title": "Success rate (24h)",
      "type": "stat"
