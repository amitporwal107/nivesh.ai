      "options": {"showHeader": true},
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "NIDP-TimescaleDB"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ingester, count(*) FILTER (WHERE status='FAILED') AS failures, count(*) FILTER (WHERE status IN ('OK','GREEN')) AS oks FROM nidp.job_log WHERE started_at >= NOW() - INTERVAL '7 days' GROUP BY ingester ORDER BY failures DESC, ingester ASC LIMIT 10",
          "refId": "A"
        }
      ],
      "title": "Top failures (7d)",
      "type": "table"
    },
    {
      "datasource": {"type": "postgres", "uid": "NIDP-TimescaleDB"},
      "description": "Hourly run counts split by status (last 7 days).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "normal"},
            "thresholdsStyle": {"mode": "off"}
          },
          "unit": "short"
