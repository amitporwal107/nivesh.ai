{
  "type": "record",
  "namespace": "in.nivesh.nidp",
  "name": "StockFeaturesDailyV1",
  "doc": "Per-stock daily technical feature pack. Topic: nidp.stock_features_daily.v1",
  "fields": [
    {"name": "as_of_date",            "type": "string"},
    {"name": "symbol",                "type": "string"},

    {"name": "close",                 "type": ["null", "double"], "default": null},

    {"name": "sma20",                 "type": ["null", "double"], "default": null},
