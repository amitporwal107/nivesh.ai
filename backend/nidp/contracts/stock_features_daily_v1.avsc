    {"name": "dist_52w_high_pct",     "type": ["null", "double"], "default": null},
    {"name": "dist_52w_low_pct",      "type": ["null", "double"], "default": null},

    {"name": "rsi14",                 "type": ["null", "double"], "default": null},
    {"name": "macd",                  "type": ["null", "double"], "default": null},
    {"name": "macd_signal",           "type": ["null", "double"], "default": null},
    {"name": "macd_hist",             "type": ["null", "double"], "default": null},
    {"name": "return_5d_pct",         "type": ["null", "double"], "default": null},
    {"name": "return_20d_pct",        "type": ["null", "double"], "default": null},
    {"name": "return_60d_pct",        "type": ["null", "double"], "default": null},

    {"name": "atr14",                 "type": ["null", "double"], "default": null},
    {"name": "atr_pct",               "type": ["null", "double"], "default": null},
