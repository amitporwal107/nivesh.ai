    {"name": "bb_pos",                "type": ["null", "double"], "default": null},

    {"name": "avg_volume_20",         "type": ["null", "long"],   "default": null},
    {"name": "vol_z20",               "type": ["null", "double"], "default": null},
    {"name": "deliv_pct_avg_20",      "type": ["null", "double"], "default": null},
    {"name": "deliv_trend10",         "type": ["null", "double"], "default": null},

    {"name": "swing_high_20",         "type": ["null", "double"], "default": null},
    {"name": "swing_low_20",          "type": ["null", "double"], "default": null},
    {"name": "pivot_breakout_flag",   "type": ["null", "boolean"], "default": null},

    {"name": "accumulation_score",    "type": ["null", "double"], "default": null},
    {"name": "accumulation_signals",  "type": {"type": "array", "items": "string"}, "default": []},

    {"name": "pe_ttm",                 "type": ["null", "double"], "default": null},
    {"name": "pb",                     "type": ["null", "double"], "default": null},
    {"name": "roe_pct",                "type": ["null", "double"], "default": null},
    {"name": "debt_to_equity",         "type": ["null", "double"], "default": null},
    {"name": "revenue_growth_yoy_pct", "type": ["null", "double"], "default": null},
    {"name": "pat_growth_yoy_pct",     "type": ["null", "double"], "default": null},
    {"name": "eps_growth_yoy_pct",     "type": ["null", "double"], "default": null},
    {"name": "latest_quarter_end",     "type": ["null", "string"], "default": null},

    {"name": "promoter_pct",            "type": ["null", "double"], "default": null},
    {"name": "fii_pct",                 "type": ["null", "double"], "default": null},
    {"name": "dii_pct",                 "type": ["null", "double"], "default": null},
    {"name": "mf_pct",                  "type": ["null", "double"], "default": null},
    {"name": "promoter_pledged_pct",    "type": ["null", "double"], "default": null},
