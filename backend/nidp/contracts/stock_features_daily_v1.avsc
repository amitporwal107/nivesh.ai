    {"name": "promoter_pct_change_qoq", "type": ["null", "double"], "default": null},
    {"name": "shareholding_period_end", "type": ["null", "string"], "default": null},

    {"name": "sector",                  "type": ["null", "string"], "default": null},
    {"name": "industry",                "type": ["null", "string"], "default": null},

    {"name": "cumulative_adj_factor",   "type": ["null", "double"], "default": null},
