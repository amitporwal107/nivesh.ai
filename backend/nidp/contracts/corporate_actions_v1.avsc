{
  "type": "record",
  "namespace": "in.nivesh.nidp",
  "name": "CorporateActionsV1",
  "doc": "One corporate-action row from NSE CA feed. Topic: nidp.corporate_actions.v1",
  "fields": [
    {"name": "symbol",            "type": "string"},
    {"name": "series",            "type": ["null", "string"], "default": null},
    {"name": "action_type",       "type": {"type": "enum", "name": "CorporateActionType",
                                            "symbols": ["DIVIDEND","DISTRIBUTION","SPLIT","BONUS","RIGHTS",
                                                        "INTEREST_PAYMENT","BUYBACK",
                                                        "MERGER","DEMERGER","OPEN_OFFER",
                                                        "DELISTING","CAPITAL_REDUCTION","SPIN_OFF",
                                                        "ESOP","AGM","EGM","POSTAL_BALLOT",
                                                        "BOARD_MEETING","OTHER"],
                                            "default": "OTHER"}},
    {"name": "action_subtype",    "type": ["null", "string"], "default": null},
    {"name": "purpose",           "type": ["null", "string"], "default": null},
    {"name": "ratio",             "type": ["null", "string"], "default": null},
    {"name": "face_value_pre",    "type": ["null", "double"], "default": null},
    {"name": "face_value_post",   "type": ["null", "double"], "default": null},
    {"name": "dividend_amount",   "type": ["null", "double"], "default": null},
    {"name": "record_date",       "type": ["null", "string"], "default": null},
    {"name": "ex_date",           "type": "string"},
    {"name": "bc_start_date",     "type": ["null", "string"], "default": null},
    {"name": "bc_end_date",       "type": ["null", "string"], "default": null},
    {"name": "announcement_date", "type": ["null", "string"], "default": null},
    {"name": "source",            "type": "string", "default": "NSE_CA"},
    {"name": "source_run_id",     "type": "string"}
  ]
}
