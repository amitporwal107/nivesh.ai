{
  "type": "record",
  "namespace": "in.nivesh.nidp",
  "name": "BlockDealsV1",
  "doc": "One block-deal row from NSE block.csv. Topic: nidp.block_deals.v1",
  "fields": [
    {"name": "as_of_date",   "type": "string"},
    {"name": "symbol",       "type": "string"},
    {"name": "client_name",  "type": "string"},
    {"name": "deal_type",    "type": {"type": "enum", "name": "BlockDealType", "symbols": ["BUY", "SELL"]}},
    {"name": "quantity",     "type": "long"},
    {"name": "avg_price",    "type": "double"},
    {"name": "deal_seq",     "type": "int", "default": 1},
    {"name": "remarks",      "type": ["null", "string"], "default": null},
    {"name": "source",       "type": "string", "default": "NSE_BLOCK"},
    {"name": "source_run_id","type": "string"}
  ]
}
