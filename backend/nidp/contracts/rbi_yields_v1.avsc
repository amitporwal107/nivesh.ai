{
  "type": "record",
  "namespace": "in.nivesh.nidp",
  "name": "RbiYieldsV1",
  "doc": "Daily RBI G-Sec / T-Bill yield. Topic: nidp.rbi_yields.v1",
  "fields": [
    {"name": "as_of_date",   "type": "string"},
