{
  "type": "record",
  "namespace": "in.nivesh.nidp",
  "name": "FnoBhavcopyV1",
  "doc": "One F&O contract row from NSE EOD bhavcopy. Topic: nidp.fno_bhavcopy.v1",
  "fields": [
    {"name": "as_of_date",          "type": "string"},
    {"name": "biz_date",            "type": ["null", "string"], "default": null},
    {"name": "instrument_type",     "type": {"type": "enum", "name": "FnoInstrumentType",
                                              "symbols": ["FUTIDX","FUTSTK","OPTIDX","OPTSTK","IDF","STF","IDO","STO","UNKNOWN"],
                                              "default": "UNKNOWN"}},
    {"name": "ticker_symbol",       "type": "string"},
    {"name": "isin",                "type": ["null", "string"], "default": null},
    {"name": "series",              "type": ["null", "string"], "default": null},
    {"name": "expiry_date",         "type": "string"},
    {"name": "actual_expiry_date",  "type": ["null", "string"], "default": null},
    {"name": "strike_price",        "type": ["null", "double"], "default": null},
    {"name": "option_type",         "type": ["null", "string"], "default": null},
    {"name": "open_price",          "type": ["null", "double"], "default": null},
    {"name": "high_price",          "type": ["null", "double"], "default": null},
    {"name": "low_price",           "type": ["null", "double"], "default": null},
    {"name": "close_price",         "type": ["null", "double"], "default": null},
    {"name": "last_price",          "type": ["null", "double"], "default": null},
    {"name": "prev_close_price",    "type": ["null", "double"], "default": null},
    {"name": "settle_price",        "type": ["null", "double"], "default": null},
    {"name": "underlying_price",    "type": ["null", "double"], "default": null},
    {"name": "open_interest",       "type": ["null", "long"], "default": null},
    {"name": "change_in_oi",        "type": ["null", "long"], "default": null},
    {"name": "traded_volume",       "type": ["null", "long"], "default": null},
    {"name": "traded_value",        "type": ["null", "double"], "default": null},
    {"name": "num_trades",          "type": ["null", "long"], "default": null},
    {"name": "new_board_lot_qty",   "type": ["null", "int"], "default": null},
    {"name": "source",              "type": "string", "default": "NSE_FO_BHAV"},
    {"name": "source_run_id",       "type": "string"}
  ]
}
