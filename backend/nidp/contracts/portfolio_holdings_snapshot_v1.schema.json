{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nivesh.ai/schemas/portfolio_holdings_snapshot_v1.schema.json",
  "title": "PortfolioHoldingsSnapshotV1",
  "type": "object",
  "required": ["external_user_id", "snapshot_date", "source_system", "holdings"],
  "additionalProperties": false,
  "properties": {
    "external_user_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "snapshot_date":    {"type": "string", "format": "date"},
    "source_system":    {"type": "string", "enum": ["nsdl_cas", "manual", "advisor_import", "other"]},
    "holdings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_class", "instrument_name", "market_value_inr"],
        "additionalProperties": false,
        "properties": {
          "asset_class":       {"type": "string", "enum": ["EQUITY", "MF", "MUTUAL_FUND", "ETF", "DEBT", "CASH", "OTHER"]},
          "symbol":            {"type": ["string", "null"], "maxLength": 64},
          "isin":              {"type": ["string", "null"], "maxLength": 24},
          "amfi_scheme_code":  {"type": ["string", "null"], "maxLength": 32},
          "instrument_name":   {"type": "string", "minLength": 1, "maxLength": 256},
          "quantity":          {"type": ["number", "null"]},
          "avg_buy_price":     {"type": ["number", "null"]},
          "market_value_inr":  {"type": "number", "minimum": 0},
          "weight_pct":        {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "metadata_json":     {"type": ["object", "null"], "additionalProperties": true}
        }
      }
    }
  }
}
