{
  "type": "record",
  "namespace": "in.nivesh.nidp",
  "name": "IndexCloseV1",
  "doc": "Daily index OHLC + valuation ratios from NSE ind_close_all. Topic: nidp.index_close.v1",
  "fields": [
    {"name": "as_of_date",   "type": "string"},
    {"name": "index_name",   "type": "string"},
    {"name": "open_price",   "type": ["null", "double"], "default": null},
    {"name": "high_price",   "type": ["null", "double"], "default": null},
    {"name": "low_price",    "type": ["null", "double"], "default": null},
    {"name": "close_price",  "type": ["null", "double"], "default": null},
    {"name": "pe_ratio",     "type": ["null", "double"], "default": null},
    {"name": "pb_ratio",     "type": ["null", "double"], "default": null},
    {"name": "div_yield",    "type": ["null", "double"], "default": null},
    {"name": "pts_change",   "type": ["null", "double"], "default": null},
    {"name": "pct_change",   "type": ["null", "double"], "default": null},
    {"name": "volume",       "type": ["null", "long"],   "default": null},
    {"name": "turnover",     "type": ["null", "double"], "default": null},
    {"name": "source",       "type": "string", "default": "NSE_IND_CLOSE"},
    {"name": "source_run_id","type": "string"}
  ]
}
