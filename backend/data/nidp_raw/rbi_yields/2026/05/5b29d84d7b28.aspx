    $(document).ready(function () {

        var pagename = window.location.href.toLowerCase();
        var n = pagename.lastIndexOf('=');
        var result = pagename.substring(n + 1);

        if (result.toLowerCase() == "7") {
            document.getElementById("Label1").innerHTML = "Monetary Aggregates*";
            document.getElementById("Label2").innerHTML = "Financial Sector";
        }
        else if (result.toLowerCase() == "8") {
            document.getElementById("Label1").innerHTML = "Analytical Accounts of the Central Bank";
            document.getElementById("Label2").innerHTML = "Financial Sector";
        }
        else if (result.toLowerCase() == "4") {
            document.getElementById("Label1").innerHTML = "Interest Rates";
            document.getElementById("Label2").innerHTML = "Financial Sector";
        }
        else if (result.toLowerCase() == "16") {
            document.getElementById("Label1").innerHTML = "Stock Market";
            document.getElementById("Label2").innerHTML = "Financial Sector";
        }        
        else if (result.toLowerCase() == "2") {
            document.getElementById("Label1").innerHTML = "International Reserves";
            document.getElementById("Label2").innerHTML = "External Sector";
        }

    });



